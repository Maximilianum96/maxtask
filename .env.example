# HACOY Daily News Tracker — Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# Google Sheets API — Service Account credentials (JSON string)
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable the Google Sheets API, download the JSON key, and paste its contents here.
# Service account email: hacoy-news-tracker-acc@hacoy-news-tracker-2026.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Google Sheet ID — The ID from your Google Sheet URL
# Sheet: https://docs.google.com/spreadsheets/d/1Mv-Nx0iDBG4cnZhf7Waxm9HdcJsvy_p7Z4b0TSPqk5E/edit
# Share the sheet with: hacoy-news-tracker-acc@hacoy-news-tracker-2026.iam.gserviceaccount.com
GOOGLE_SHEET_ID=1Mv-Nx0iDBG4cnZhf7Waxm9HdcJsvy_p7Z4b0TSPqk5E
